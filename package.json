{
  "name": "totp-extractor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node --import tsx scripts/build-static.ts",
    "preview": "node server.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "lucide": "1.76.0",
    "protobufjs": "8.8.1",
    "qrcode": "1.5.4",
    "zxing-wasm": "3.1.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "license": "MIT"
}
